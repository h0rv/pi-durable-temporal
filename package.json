{
	"name": "@h0rv/pi-durable-temporal",
	"version": "0.1.0",
	"description": "A Temporal integration for Pi Durable",
	"type": "module",
	"license": "MIT",
	"sideEffects": [
		"./dist/workflow-globals.js",
		"./src/workflow-globals.ts"
	],
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./workflow": {
			"types": "./dist/workflow.d.ts",
			"import": "./dist/workflow.js"
		},
		"./agent-harness": {
			"types": "./dist/agent-harness.d.ts",
			"import": "./dist/agent-harness.js"
		}
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "biome check . && tsc --noEmit",
		"test": "vitest run --dir test --maxWorkers=2",
		"example": "tsx examples/local.ts",
		"example:worker": "tsx examples/agent-harness/worker.ts",
		"example:e2e": "tsx examples/agent-harness/e2e.ts",
		"example:console": "tsx examples/agent-harness/console.ts",
		"example:release": "tsx examples/release/run.ts",
		"example:approval": "tsx examples/agent-harness/human.ts",
		"prepack": "npm run build",
		"test:package": "node scripts/test-package.mjs",
		"dev": "tsx examples/dev.ts",
		"example:coding": "tsx examples/coding/run.ts",
		"example:mcp": "tsx examples/mcp/run.ts",
		"example:client:setup": "node scripts/native-client.mjs setup",
		"example:client": "node scripts/native-client.mjs client",
		"example:client:server": "node scripts/native-client.mjs server",
		"example:client:worker": "node scripts/native-client.mjs worker",
		"example:client:test": "node scripts/native-client.mjs test",
		"example:client:check": "node .local/pi-upstream/node_modules/typescript/bin/tsc -p examples/native-client/tsconfig.json"
	},
	"dependencies": {
		"@temporalio/activity": "1.24.0",
		"@temporalio/common": "1.24.0",
		"@temporalio/workflow": "1.24.0",
		"@ungap/structured-clone": "1.4.0"
	},
	"peerDependencies": {
		"@earendil-works/chord": "1.0.4",
		"@earendil-works/pi-ai": "1.0.4",
		"@earendil-works/pi-durable": "1.0.4",
		"protobufjs": "8.8.0",
		"typebox": "1.3.27",
		"@temporalio/agent-harness-client": "0.1.0"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "3.1147.0",
		"@biomejs/biome": "2.3.5",
		"@earendil-works/chord": "1.0.4",
		"@earendil-works/pi-ai": "1.0.4",
		"@earendil-works/pi-codemode": "1.0.4",
		"@earendil-works/pi-durable": "1.0.4",
		"@earendil-works/pi-mcp": "1.0.4",
		"@modelcontextprotocol/server-filesystem": "2026.8.31",
		"@temporalio/agent-harness-client": "0.1.0",
		"@temporalio/client": "1.24.0",
		"@temporalio/external-storage-s3": "1.24.0",
		"@temporalio/external-storage-s3-aws-sdk": "1.24.0",
		"@temporalio/proto": "1.24.0",
		"@temporalio/testing": "1.24.0",
		"@temporalio/worker": "1.24.0",
		"@temporalio/workflow-streams": "1.24.0",
		"@types/node": "24.10.1",
		"@types/ungap__structured-clone": "1.2.0",
		"acorn": "8.17.0",
		"fflate": "0.8.3",
		"protobufjs": "8.8.0",
		"tsx": "4.20.6",
		"typebox": "1.3.27",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/h0rv/pi-durable-temporal.git"
	},
	"homepage": "https://github.com/h0rv/pi-durable-temporal#readme",
	"bugs": {
		"url": "https://github.com/h0rv/pi-durable-temporal/issues"
	},
	"keywords": [
		"pi",
		"temporal",
		"agents",
		"durable-execution"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"peerDependenciesMeta": {
		"@temporalio/agent-harness-client": {
			"optional": true
		}
	}
}
